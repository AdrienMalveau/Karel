# Projet : Karel le jardinier

definir tourner_droite:
    repeter 3 fois:
        tourner_gauche

definir ramasser_ligne:
    si balise_ici:
        ramasser_balise
    tant que devant_libre:
        avancer
        si balise_ici:
            ramasser_balise

definir change_de_ligne:
    si regarde_est:
        si devant_libre:
            tourner_gauche
            avancer
            tourner_gauche
    sinon:
        si devant_libre:
            tourner_droite
            avancer
            tourner_droite


tant que devant_libre:
    ramasser_ligne
    si pas devant_libre:
        change_de_ligne